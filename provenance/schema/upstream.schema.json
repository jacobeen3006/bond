{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://halo.local/provenance/upstream.schema.json",
  "title": "HALO upstream provenance ledger",
  "description": "One vendored subtree's origin and byte-fidelity record. Every digest is computed over the document bytes it names.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "subtree",
    "local_root",
    "repo",
    "commit",
    "commit_committed_at",
    "default_branch",
    "object_format",
    "import",
    "license",
    "lockfiles",
    "counts",
    "manifests",
    "excludes_sha256",
    "renames_sha256"
  ],
  "properties": {
    "schema": { "const": "halo/upstream/v1" },
    "subtree": { "type": "string", "minLength": 1, "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "local_root": { "type": "string", "pattern": "^vendor/[a-z0-9][a-z0-9-]*$" },
    "repo": {
      "type": "string",
      "pattern": "^https://[^/]+/",
      "description": "HTTPS clone URL. A non-HTTPS remote is a schema violation, not only a fetch-time refusal."
    },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "commit_committed_at": {
      "type": "string",
      "minLength": 1,
      "description": "The upstream commit's own timestamp. Independent of import.date; both are emitted even when identical."
    },
    "default_branch": { "type": "string", "minLength": 1 },
    "tag": { "type": ["string", "null"] },
    "object_format": { "type": "string", "enum": ["sha1"] },
    "import": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "date",
        "tool",
        "git_version",
        "lfs_version",
        "staging_attributes",
        "staging_attributes_value"
      ],
      "properties": {
        "mode": { "type": "string", "enum": ["archive"] },
        "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "tool": { "type": "string", "minLength": 1 },
        "git_version": { "type": "string", "minLength": 1 },
        "lfs_version": { "type": "string", "minLength": 1 },
        "staging_attributes": { "type": "string", "const": ".git/info/attributes" },
        "staging_attributes_value": {
          "type": "string",
          "const": "* -text -filter -ident -working-tree-encoding"
        }
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spdx", "files", "copyright_notice_count"],
      "properties": {
        "spdx": { "type": "string", "minLength": 1 },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "blob", "sha256"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "blob": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
              "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
            }
          }
        },
        "copyright_notice_count": { "type": "integer", "minimum": 0 }
      }
    },
    "lockfiles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["files", "bytes", "lfs_files", "symlinks", "executables"],
      "properties": {
        "files": { "type": "integer", "minimum": 0 },
        "bytes": { "type": "integer", "minimum": 0 },
        "lfs_files": { "type": "integer", "minimum": 0 },
        "symlinks": { "type": "integer", "minimum": 0 },
        "executables": { "type": "integer", "minimum": 0 }
      }
    },
    "manifests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["upstream", "upstream_sha256", "vendored", "vendored_sha256"],
      "properties": {
        "upstream": { "type": "string", "const": "provenance/MANIFEST.upstream.tsv" },
        "upstream_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "vendored": { "type": "string", "const": "provenance/MANIFEST.vendored.tsv" },
        "vendored_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "excludes_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "SHA-256 of the EXCLUDES.json document bytes."
    },
    "renames_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "SHA-256 of the RENAMES.json document bytes."
    },
    "notes": {
      "type": "object",
      "description": "Build facts the imported tree declares about itself (Python constraint, package manager, workspace root, root lockfiles). Recorded here rather than re-hosted at the HALO root (DEC-04). Optional so earlier ledgers stay valid.",
      "additionalProperties": { "type": "string", "minLength": 1 }
    }
  }
}
